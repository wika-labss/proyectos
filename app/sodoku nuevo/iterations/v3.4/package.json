{
  "name": "sodoku-nuevo",
  "version": "3.4.0",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:levels": "npx --yes tsx scripts/validate-levels.ts",
    "smoke:v3": "npx --yes tsx scripts/smoke-v3.ts",
    "prebuild:android": "expo prebuild --platform android --clean && node scripts/post-prebuild.js",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "build:apk": "npm run validate:levels && npm run typecheck && npm run prebuild:android && npm run apk:release",
    "verify:build": "bash scripts/verify-build.sh",
    "start": "expo start"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "typescript": "~5.3.0"
  },
  "private": true
}
