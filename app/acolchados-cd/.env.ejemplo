# Copia este archivo como .env y rellena los valores.
# Después:  chmod 600 .env

# ─── Panel de administración ──────────────────────────────────────────────
# URL secreta del panel -> https://vissiuss.lat/<ADMIN_PATH>
ADMIN_PATH=panel-cambiame

ADMIN_USUARIO=carlos
# Solo hace falta la PRIMERA vez, para crear la cuenta. Después de entrar una
# vez, déjala vacía: la clave ya vive cifrada en la base de datos y aquí solo
# sería una copia en texto plano dentro de todos los respaldos.
ADMIN_CLAVE=pon-aqui-una-clave-larga

# 1 en producción (HTTPS por Cloudflare). 0 solo para probar por red local.
COOKIE_SEGURA=1
HORAS_SESION=8

# ─── Correo de las cotizaciones ───────────────────────────────────────────
# Por dónde salen los correos. Sirve cualquier SMTP autenticado:
#   Brevo   -> smtp-relay.brevo.com : 587, usuario = correo de la cuenta
#   Resend  -> smtp.resend.com      : 465, usuario = resend
#   Gmail   -> smtp.gmail.com       : 587, usuario = la cuenta + clave de aplicación
SMTP_HOST=smtp-relay.brevo.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=

# El remitente que ve quien recibe. NO tiene por qué ser el usuario SMTP: en
# los servicios de envío el usuario es una credencial, no una dirección.
# Siempre nuestro, nunca el correo que escribe el visitante: poner el suyo
# sería falsificarlo, y el mensaje terminaría en spam.
CORREO_DESDE=web@vissiuss.lat
CORREO_NOMBRE=Acolchados CD

# A dónde llega la copia interna de cada cotización. Sale de aquí y nunca de
# la petición: si el visitante pudiera elegir el destinatario, tendríamos una
# máquina de mandar correo gratis en internet.
# OJO: tiene que ser una dirección que RECIBA. El correo de @vissiuss.lat
# está caído, así que en pruebas usa una que funcione.
# (CONTACTO.md del repositorio del equipo la llama CORREO_DESTINO: ese nombre
#  también se acepta, pero el que manda si están los dos es este.)
CORREO_INTERNO=

TELEFONO_CONTACTO=+56 9 9919 4045
SITIO=vissiuss.lat

# ─── Turnstile (la barrera antibots de Cloudflare, gratis) ────────────────
# Se saca en el panel de Cloudflare -> Turnstile -> Add site.
# Si se dejan vacías, el formulario funciona igual pero sin esa capa.
# La de sitio es pública (va escrita en el HTML); la secreta NO.
TURNSTILE_SITIO=
TURNSTILE_SECRETO=

# ─── Mercado Libre ────────────────────────────────────────────────────────
# Identidad de NUESTRA aplicación, no de ningún vendedor: no cambia nunca.
# Se saca en developers.mercadolibre.cl -> Mis aplicaciones.
# Las cuentas de los vendedores NO van aquí: se conectan desde el panel y se
# guardan en la base, para poder cambiar de cuenta sin tocar código.
ML_APP_ID=
ML_SECRET=

# MLC = Chile. MLA Argentina, MLB Brasil, MLM México...
ML_SITIO=MLC

# Debe coincidir EXACTAMENTE con la registrada en la aplicación de Mercado
# Libre. Si algún día la web cambia de dominio, hay que actualizarla allá.
ML_REDIRECCION=https://vissiuss.lat/api/ml/callback
