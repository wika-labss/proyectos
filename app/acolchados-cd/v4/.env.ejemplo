# Copia este archivo como .env y rellena los valores.
# Después:  chmod 600 .env

# URL secreta del panel -> https://vissiuss.lat/<ADMIN_PATH>
ADMIN_PATH=panel-cambiame

ADMIN_USUARIO=carlos
ADMIN_CLAVE=pon-aqui-una-clave-larga

# 1 en producción (HTTPS por Cloudflare). 0 solo para probar por red local.
COOKIE_SEGURA=1
HORAS_SESION=8
