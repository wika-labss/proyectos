{
  "name": "app-delivery",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "smoke": "npx --yes tsx scripts/smoke-v1.ts",
    "verify": "bash scripts/verify-build.sh",
    "verify:win": "scripts\\verify-build.bat",
    "apk": "bash scripts/build-apk.sh",
    "apk:win": "scripts\\build-apk.bat",
    "prebuild:android": "expo prebuild --platform android && node scripts/post-prebuild.js"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.0",
    "expo-camera": "~16.0.0",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.12",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "query-string": "~7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "typescript": "~5.3.0"
  },
  "private": true
}
