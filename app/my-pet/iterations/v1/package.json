{
  "name": "my-pet",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "npx tsx web/listen.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "npx tsx scripts/smoke-v1.ts",
    "smoke:web": "npx tsx scripts/smoke-web.ts",
    "verify": "npm run smoke && npm run typecheck && npm run smoke:web",
    "verify:apk": "bash scripts/verify-build.sh",
    "apk": "bash scripts/build-apk.sh",
    "apk:win": "scripts\\build-apk.bat",
    "prebuild:android": "expo prebuild --platform android && node scripts/post-prebuild.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "qrcode": "~1.5.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/qrcode": "~1.5.5",
    "@types/react": "~18.3.0",
    "tsx": "~4.19.0",
    "typescript": "~5.3.0"
  },
  "private": true
}
