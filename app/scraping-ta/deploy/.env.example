# Copia a .env (gitignored). No pongas el token Bee en git.

# Dominio Vissiuss (apex). www redirige aquí.
DOMAIN=vissiuss.com

# Let's Encrypt. Usa un correo real que controles.
ACME_EMAIL=ops@vissiuss.com

# Token ScrapingBee (Peya / Uber / Rappi). Vacío = solo Justo CDN hasta pegarlo en la UI.
SCRAPINGBEE_API_KEY=

# Admin consola (cambiar antes de publicar).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar123
SCRAPING_TA_AUTH=1
SCRAPING_TA_AGENT_URL=
