# Copia este archivo a .env y completa los valores. .env no se versiona.

# Base de datos (contenedor db)
POSTGRES_DB=trabajamos
POSTGRES_USER=trabajamos
POSTGRES_PASSWORD=cambia-esta-contrasena

# Al menos 32 caracteres aleatorios: openssl rand -base64 48
SESSION_SECRET=

# Dominio del servidor de prueba. Con un dominio real Caddy obtiene HTTPS solo.
# Sin dominio (acceso por IP) usa DOMAIN=:80 y COOKIE_SECURE=false.
DOMAIN=qa.trabajamos.com
PUBLIC_BASE_URL=https://qa.trabajamos.com
COOKIE_SECURE=true

# Geocodificación: nominatim (OpenStreetMap, gratuito) o fake (comunas de Santiago, sin red).
GEOCODER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Política de uso de Nominatim: identifica la app con un contacto real.
NOMINATIM_USER_AGENT=trabajamos.com-qa (contacto@trabajamos.com)
NOMINATIM_COUNTRYCODES=cl

# Contraseña de las cuentas de demostración que crea npm run seed.
SEED_PASSWORD=
