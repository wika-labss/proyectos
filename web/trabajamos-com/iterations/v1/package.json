{
  "name": "trabajamos-com",
  "version": "0.1.0",
  "private": true,
  "description": "trabajamos.com — portal de oficios y emprendedores cercanos (Fase 1, QA)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/scripts/migrate.js",
    "seed": "node dist/scripts/seed.js",
    "admin:reset-password": "node dist/scripts/reset-password.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "leaflet": "^1.9.4",
    "pg": "^8.13.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
